{
  "name": "@gbraver-burst-network/serverless-stub",
  "description": "gbraver burst network stub.",
  "version": "1.25.0",
  "author": "Y.Takeuchi",
  "dependencies": {
    "@gbraver-burst-network/browser-sdk": "1.25.0",
    "dotenv": "^17.4.2",
    "gbraver-burst-core": "^1.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "html-webpack-plugin": "^5.6.7",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.5.7",
    "typescript-eslint": "^8.59.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "private": true,
  "scripts": {
    "build": "run-s clean transpile",
    "clean": "rimraf build",
    "code-format": "prettier . --write",
    "code-format-check": "prettier . --check",
    "dependency-check": "depcruise src",
    "dev-server": "webpack serve",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "serve": "http-server build -p 8080 -c-1",
    "start": "run-s clean dev-server",
    "start:production": "run-s build serve",
    "transpile": "webpack --mode=production",
    "type-check": "tsc --noEmit"
  }
